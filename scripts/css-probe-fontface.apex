// Can a custom font be embedded with @font-face, served from an ASSET FILE the way
// images are? Tested because "only three fonts" is the canvas editor's most visible
// limitation, and asset-file delivery is the pattern that already solved images.
//
// RESULT as of 2026-08-05 — NO, and it fails in two different ways:
//
//   src: url(/sfc/servlet.shepherd/version/download/<cvId>)
//        -> HARD FAILURE. Blob.toPdf throws "Error accessing PDF resource" and the
//           WHOLE render dies. Adding a ContentDocumentLink with Visibility=AllUsers
//           (the fix that makes images work) does not help.
//
//   src: url(...) format('truetype')
//        -> renders, but the font is NOT applied. pdffonts on the output reports only
//           Times-Roman, not embedded: it silently fell back to the default serif.
//
// A data: URI fares no better — Blob.toPdf rejects data URIs for images too.
//
// So the three generic families (sans-serif / serif / monospace) really are the whole
// palette, and this is a genuine engine limit rather than a plumbing problem. The
// hard-failure mode matters independently: a template carrying a stray @font-face
// without a format() hint will not render at all.
// @font-face via an ASSET FILE (ContentVersion + relative shepherd URL) — the same
// mechanism images already use, and the only one Blob.toPdf accepts: absolute URLs
// and data URIs both render broken.
//
// Lydian-only font on purpose. If the rule is APPLIED, Latin text renders as
// tofu/blank because the font has no Latin glyphs. If it is IGNORED, the text
// renders normally in serif. Unambiguous either way.
String f = '';
List<ContentVersion> old = [SELECT Id FROM ContentVersion WHERE Title = 'probe_font_lydian' AND IsLatest = TRUE];
Id cvId;
if (old.isEmpty()) {
    ContentVersion cv = new ContentVersion(
        Title = 'probe_font_lydian',
        PathOnClient = 'probe.ttf',
        VersionData = EncodingUtil.base64Decode(f)
    );
    insert cv;
    cvId = cv.Id;
} else {
    cvId = old[0].Id;
}
// Link it to a record, exactly as ensureTemplateAssetImageAccessForPdf does for
// images — the PDF service fetches the shepherd URL in its own context and gets an
// access error otherwise.
Id docId = [SELECT ContentDocumentId FROM ContentVersion WHERE Id = :cvId].ContentDocumentId;
Account anchor = [SELECT Id FROM Account LIMIT 1];
if ([SELECT COUNT() FROM ContentDocumentLink WHERE ContentDocumentId = :docId AND LinkedEntityId = :anchor.Id] == 0) {
    insert new ContentDocumentLink(
        ContentDocumentId = docId,
        LinkedEntityId = anchor.Id,
        ShareType = 'V',
        Visibility = 'AllUsers'
    );
}
String url = '/sfc/servlet.shepherd/version/download/' + cvId;
System.debug('FONTCV ' + cvId);
String html =
    '<!DOCTYPE html><html><head><meta charset="utf-8"/><style>' +
    '@page { size: Letter portrait; margin: 0.5in; }' +
    '@font-face { font-family: ProbeFace; src: url(' +
    url +
    ') format(\'truetype\'); }' +
    'body { font-size: 12pt; }' +
    '.probe { font-family: ProbeFace; font-size: 24pt; }' +
    '.ctrl { font-family: serif; font-size: 24pt; }' +
    '</style></head><body>' +
    '<p>CONTROL (serif):</p><p class="ctrl">Handgloves 123</p>' +
    '<p>@font-face from an asset file:</p><p class="probe">Handgloves 123</p>' +
    '</body></html>';
Blob pdf = Blob.toPdf(html);
String o = EncodingUtil.base64Encode(pdf);
System.debug('SIZE ' + pdf.size());
for (Integer i = 0; i < o.length(); i += 900) {
    System.debug('B64>' + o.substring(i, Math.min(i + 900, o.length())));
}
